 "adjustments": [
  {
   "id": "vsync_off",
   "when": "always",
   "set": {
    "setting.mat_vsync": 0
   },
   "reason": "V-Sync adds a frame of latency and caps you at the refresh rate. On a high refresh panel that trade is not worth it in a competitive shooter."
  },
  {
   "id": "reflex_nvidia",
   "when": "gpu_reflex",
   "set": {
    "setting.r_low_latency": 2
   },
   "reason": "NVIDIA Reflex + Boost keeps the render queue short. Reflex is the single largest latency win available in CS2 on GeForce hardware."
  },
  {
   "id": "reflex_unsupported",
   "when": "not_gpu_reflex",
   "set": {
    "setting.r_low_latency": 0
   },
   "reason": "Reflex is a GeForce feature; leaving it on elsewhere does nothing useful."
  },
  {
   "id": "vram_texture_cap",
   "when": "vram_below_6",
   "set": {
    "setting.videocfg_texture_detail": 0,
    "setting.gpu_mem_level": 0
   },
   "reason": "Under 6 GB of VRAM, high texture detail causes stutter as the pool spills to system memory. Frame pacing matters more than texel density."
  },
  {
   "id": "msaa_cut_4k",
   "when": "pixels_above_4mp_and_tier_below_s",
   "set": {
    "setting.msaa_samples": 0
   },
   "reason": "MSAA cost scales with resolution. Above roughly 4 megapixels it is the first thing to drop on anything short of a top-tier GPU."
  },
  {
   "id": "no_upscaling_when_ample",
   "when": "headroom_above_1_3",
   "set": {
    "setting.videocfg_fsr_detail": 0
   },
   "reason": "You already clear the refresh rate without upscaling, so rendering below native only costs image quality."
  },
  {
   "id": "keep_gpu_quality_when_cpu_bound",
   "when": "gpu_ahead_of_cpu",
   "set": {
    "setting.r_texturefilteringquality": 3,
    "setting.videocfg_hdr_detail": 2
   },
   "reason": "The graphics card can already draw more frames than the processor can feed it, so the processor is the limit. Texture filtering and HDR cost GPU time and no CPU time, which means turning them down here buys no frames at all and only costs picture quality. Anisotropic 4x and HDR Quality are what the pro-settings surveys recommend, and this machine gets them for free.",
   "sources": [
    "https://prosettings.net/guides/cs2-options/",
    "https://www.steamdb.com/en/articles/cs2-best-settings-for-competitive"
   ]
  }
 ]
}
