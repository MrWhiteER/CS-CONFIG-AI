# Line endings are decided here rather than by whatever each machine has
# configured, so a checkout on one is byte-identical to a checkout on another.
* text=auto

# Windows shells break on LF: cmd reads a .bat line at a time and a stray LF
# ending can split a command, and PowerShell's parser is no happier.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Kept as-is deliberately. The application preserves the line endings of the
# CS2 configuration files it reads, and the tests assert byte-exact round
# trips -- normalising these fixtures would quietly break that.
*.vcfg  -text
*.cfg   -text

# Binary, so no diffing or normalising.
*.ico   binary
*.png   binary
*.zip   binary
*.exe   binary
